\newcommand{\hypothesiscard}[4]{%
  \begin{tcolorbox}[
    colframe=arsenic,
    colback=gray05,
    boxrule=0.5pt,
    leftrule=3.5pt,
    arc=2mm,
    top=6pt, bottom=6pt, left=8pt, right=8pt,
    before skip=6pt, after skip=6pt
  ]
    % Header
    \noindent
    \small\textbf{\color{arsenic}\faIcon{flask}\ Hypothesis #1} 
    \hfill 
    \begingroup\color{arsenic!80!black}\faIcon{project-diagram}\ \textit{\footnotesize #2}\endgroup
    
    \vspace{3pt}{\color{gray20}\rule{\linewidth}{0.4pt}}\vspace{3pt}
    
    % Body: H0 vs Ha
    \small
    \noindent\textcolor{red!70!black}{\textbf{\textsf{[H\textsubscript{0,#1}]}}} #3\\[3pt]
    \noindent\textcolor{blue!80!black}{\textbf{\textsf{[H\textsubscript{a,#1}]}}} #4
  \end{tcolorbox}%
}



