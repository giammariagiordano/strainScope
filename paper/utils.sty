% === environment rqbox (accetta un argomento: il titolo) ===
\newenvironment{stebox1}{%
  \par\smallskip\noindent
  \setlength{\tabcolsep}{0pt}%
  \begin{tabular}{@{}p{3pt}p{\dimexpr\linewidth-3pt\relax}@{}}%
    \cellcolor{myred}\rule{0pt}{0pt} &
    \cellcolor{gray05}%
    \begingroup
      \setlength{\parindent}{0pt}%
      \hspace*{\ste@pad}%
      \begin{minipage}[t]{\dimexpr\hsize-2\ste@pad\relax}%
      
      \ignorespaces
}{%
      \par\vspace*{\ste@pad}%
      \end{minipage}%
      \hspace*{\ste@pad}%
    \endgroup
    \\%
  \end{tabular}%
  \par\smallskip
}


